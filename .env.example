# Skopiuj ten plik jako .env i ustaw własne wartości.
# Plik .env jest w .gitignore - nigdy go nie commitujemy.
POSTGRES_USER=homeapp
POSTGRES_PASSWORD=password
# Adres IP komputera w domowej sieci Wi-Fi (ipconfig -> karta Wi-Fi -> IPv4 Address).
# Caddy wystawia na niego certyfikat HTTPS, żeby apka działała na telefonie (Krok 13b).
LAN_IP=192.168.1.23
